FREEIMAGE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PORT=4035
DB_PATH=data/conversations.db
CHATGPT_INCLUDE_SOURCES=0
# Optional read-through cache for conversation continuity and model lists.
# Empty REDIS_URL disables Redis; SQLite stays authoritative.
#REDIS_URL=redis://127.0.0.1:6379/0
# Prefix for chatgpt-to-openai-api keys (colon-separated per redis-core).
#REDIS_KEY_PREFIX=c2o:
# Single pooled client (redis-connections), fail-fast connect timeout.
#REDIS_CONNECT_TIMEOUT=2
# Per-call socket timeout in seconds.
#REDIS_SOCKET_TIMEOUT=5
# Idle pool size for the single shared client.
#REDIS_MAX_CONNECTIONS=50
# Cache TTL in seconds (defaults to CONVERSATION_TTL_HOURS * 3600).
#REDIS_TTL_SECONDS=604800
# Snapshots larger than this stay SQLite-only (metadata still cached).
#REDIS_SNAPSHOT_MAX_BYTES=262144

# session keepalive — accounts in accounts.txt stay alive indefinitely.
# Values must be bare (no inline comments): the loader does not strip them.
#KEEPALIVE_SECONDS=600
# Sweep interval in seconds.
#KEEPALIVE_REFRESH_WITHIN=86400
# Refresh the access token when less than this much JWT validity remains.
#KEEPALIVE_MAX_STRIKES=3
# Consecutive bad refreshes before an account needs re-login.
#KEEPALIVE_REVIVE_SECONDS=900
# Re-probe dead accounts this often (seconds).
#KEEPALIVE_MIN_IMPROVEMENT=300
# A pasted block hot-swaps only if its JWT outlives the in-memory one by this.
